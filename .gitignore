# Dependencies
node_modules/
.venv/
# Root node_modules symlink -> frontend/node_modules (so plugin TSX
# outside the Vite project can resolve bare imports like "react"). The
# trailing-slash ``node_modules/`` rule above matches real dirs but not
# this root symlink (git treats the symlink as a file), so anchor it.
/node_modules

# Build output
frontend/dist/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
.zed/

# Large model files (too big for GitHub)
models/
*.gguf

# Per-user chat data
data/

# Plugins directory
plugins/

# Personal server config. The app reads a single ``config.toml`` at the
# project root; this file is no longer loaded by anything and is kept
# only as a personal reference copy, so it stays untracked.
config.toml
